{
  "name": "@yoink/api-contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./orpc": {
      "types": "./dist/orpc/index.d.ts",
      "import": "./dist/orpc/index.js"
    },
    "./public-api/v1": {
      "types": "./dist/public-api/v1/index.d.ts",
      "import": "./dist/public-api/v1/index.js"
    },
    "./extension/v1": {
      "types": "./dist/extension/v1/index.d.ts",
      "import": "./dist/extension/v1/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --config eslint.config.js \"src/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@orpc/contract": "2.0.0-beta.48",
    "@orpc/openapi": "2.0.0-beta.48",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
