{
  "name": "@yoink/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:reset && ../../scripts/dev-seed.sh",
    "dev:reset": "rm -rf ./data/captures.db ./data/captures.db-* && pnpm run migrate:dev",
    "build": "tsc",
    "start": "node --experimental-sqlite --import ./dist/instrument.js dist/index.js",
    "migrate": "node --experimental-sqlite dist/migrate.js",
    "migrate:dev": "tsx --experimental-sqlite src/migrate.ts",
    "lint": "eslint --config eslint.config.js \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.1",
    "@libsql/client": "^0.15.15",
    "@sentry/node": "^10.32.1",
    "@simplewebauthn/server": "^13.2.2",
    "@ts-rest/fastify": "3.52.1",
    "@yoink/api-contracts": "workspace:*",
    "@yoink/infrastructure": "workspace:*",
    "fastify": "^5.12.7",
    "neverthrow": "^8.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0"
  }
}
